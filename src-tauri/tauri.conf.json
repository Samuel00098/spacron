{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spacron",
  "version": "5.1.1",
  "identifier": "com.samue.spacron",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-server-sidecar.js && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Spacron",
        "width": 1200,
        "height": 800,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost http://127.0.0.1:*; font-src 'self'; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* wss://api.x.ai wss://ai-gateway.vercel.sh; frame-src 'self' http://127.0.0.1:* https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; worker-src 'self' blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/backgrounds/*",
          "$CONFIG/spacron/backgrounds/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": [
          "spacron"
        ],
        "name": "Spacron Project",
        "description": "Spacron project",
        "mimeType": "application/x-spacron-project",
        "contentTypes": [
          "public.folder"
        ],
        "exportedType": {
          "identifier": "com.samue.spacron.project",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ],
    "externalBin": [
      "binaries/spacron-server",
      "binaries/spacron-open"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/desktop.template"
      },
      "rpm": {
        "desktopTemplate": "linux/desktop.template"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2NTMxNTZCQTFCMzg5NEYKUldSUGliT2hheFZURnBla2dIcTBzSHJtdnQ5TTNSemxPSmdCVUo2dTcwQXZtYmhPeW1Vd2crK2YK",
      "endpoints": [
        "https://github.com/Samuel00098/spacron-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
