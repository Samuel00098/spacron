{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spacron",
  "version": "0.6.5",
  "identifier": "com.samue.spacron",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Spacron",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": false,
        "shadow": false,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost http://127.0.0.1:* https://i.ytimg.com https://*.ytimg.com https://yt3.ggpht.com; font-src 'self'; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost https://www.youtube.com https://*.googlevideo.com; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* wss://api.x.ai https://www.googleapis.com https://i.ytimg.com https://www.youtube.com https://*.googlevideo.com; frame-src 'self' http://127.0.0.1:* https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; worker-src 'self' blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/backgrounds/*",
          "$CONFIG/spacron/backgrounds/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2NTMxNTZCQTFCMzg5NEYKUldSUGliT2hheFZURnBla2dIcTBzSHJtdnQ5TTNSemxPSmdCVUo2dTcwQXZtYmhPeW1Vd2crK2YK",
      "endpoints": [
        "https://github.com/Samuel00098/spacron-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
