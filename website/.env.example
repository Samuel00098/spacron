# Spacron website: env config
# Local: copy to website/.env.local. Production: Vercel > Project > Settings >
# Environment Variables. Never commit real values (.env.* is gitignored).
#
# LICENSING MODES (decided by the three LEMONSQUEEZY_*/DOWNLOAD_* values below)
#   All three empty   -> "open": /download gives free downloads (early access for friends).
#   All three set     -> "enforced": a valid Spacron license key is required to download.
#   Only some set     -> downloads are switched off until the setup is finished (fails closed).

# "Buy now" target: your Lemon Squeezy checkout URL for the Spacron product
# (Lemon Squeezy > Products > Spacron > Share / checkout link).
# Until this is set, Buy buttons go to /download.
SPACRON_CHECKOUT_URL=

# Lemon Squeezy store id (Settings > Stores, the number next to your store)
# and the Spacron product id (Products > Spacron, the number in the page URL).
# Keys from any other store or product are rejected.
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=

# Random secret (at least 32 characters) that signs the 15-minute download links.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOWNLOAD_TOKEN_SECRET=
